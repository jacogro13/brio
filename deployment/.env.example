# Production stack on the mini-PC. Copied to the mini-PC by `deployment/deploy.sh`,
# loaded by the `docker compose` invocation in `deployment/docker-compose.yml`.
# The app talks to `shared_postgres` over `shared_network` — no DB_PORT here.
# For the full list of vars the code reads, see the dev `../.env.example`.

# PostgreSQL credentials. The role + database are created by
# Infrastructure/init/01-init.sh; this app connects as its own least-privilege
# role `chatbot_app` (owns only chatbot). DB_PASSWORD must match
# CHATBOT_DB_PASSWORD in Infrastructure/deployment/.env.
DB_USER=chatbot_app
DB_PASSWORD=your_db_password
DB_NAME=chatbot

# Auth (Phase 7) — JWT bearer + bcrypt. REQUIRED: the api won't start without a
# JWT_SECRET_KEY. Generate one with `openssl rand -hex 32`. Keep it stable across
# deploys — rotating it invalidates every issued token (all users re-login).
JWT_SECRET_KEY=your_jwt_secret_key
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200
# LOGIN_RATE_LIMIT=5/minute

# Chat LLM (any OpenAI-compatible server). Defaults to the shared_network gateway
# (http://10.100.0.1:8080) = the mini-PC host, where llama.cpp runs as a host
# systemd service (Infrastructure/llm) — the same shared LLM used by
# Registro_Spese/Pasti/Blibiobot. LLM_MODEL must match what llama.cpp is serving.
# Sending a message errors cleanly when llama is down; reads work.
# LLM_BASE_URL=http://10.100.0.1:8080
LLM_MODEL=google_gemma-3-12b-it-Q4_K_M.gguf

# Reasoning/thinking (Phase 3). Server-wide DEFAULT for enable_thinking; when true
# the adapter sends chat_template_kwargs.enable_thinking=true and surfaces the model's
# reasoning in a collapsible panel. A conversation's per-conversation "Thinking" setting
# (Phase 4 ⚙ popover) overrides it when set. Only useful with a reasoning model
# (e.g. Gemma 4 26B-A4B); forwarded to the container via `env_file`.
# LLM_CHAT_ENABLE_THINKING=true

# Attachments — SHARED Garage S3 (shared_garage on shared_network, managed by
# Infrastructure/). The api reaches it via the `garage` alias (compose sets
# GARAGE_ENDPOINT). Add `chatbot` to GARAGE_BUCKETS in Infrastructure/deployment/.env
# and re-run garage_init once so the bucket exists and this key is granted
# read+write on it. The access key/secret must match a key provisioned in the
# shared garage.
GARAGE_BUCKET=chatbot
GARAGE_ACCESS_KEY_ID=your_garage_access_key_id
GARAGE_SECRET_ACCESS_KEY=your_garage_secret_access_key

# Web access (Phase 6). The 🌐 composer toggle runs a prompted-JSON tool loop
# (DuckDuckGo search via `ddgs` + trafilatura page extraction), thinking forced
# off for the turn. Needs outbound internet from the container. Set
# WEB_TOOLS_ENABLED=false to disable (mock adapters). Defaults are fine to omit.
# WEB_TOOLS_ENABLED=true
# WEB_TOOL_MAX_ITERATIONS=4
# WEB_SEARCH_MAX_RESULTS=5
# WEB_FETCH_MAX_CHARS=20000

# GitHub user or organisation whose GHCR packages hold the images
# (ghcr.io/<owner>/chatbot-api, …-frontend).
GHCR_OWNER=your_github_user

# Optional: pin to a specific image tag for rollback (defaults to latest).
# IMAGE_TAG=sha-abc1234

# Optional: override the published frontend host port (defaults to 120).
# FRONTEND_HOST_PORT=120
