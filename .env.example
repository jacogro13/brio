 # Database — used by `make backend`. Docker Compose overrides DB_HOST/DB_PORT
# with the internal hostname; DB_PORT here is the host-mapped Postgres port and
# must match the left side of `ports:` in docker-compose.yml.
DB_USER=chatbot
DB_PASSWORD=changeme
DB_NAME=chatbot
DB_PORT=5434

# Used by: make backend (local dev). Docker Compose overrides with internal hostname.
DATABASE_URL=postgresql+asyncpg://chatbot:changeme@localhost:5434/chatbot

# LLM — any OpenAI-compatible server (Ollama, llama.cpp, LM Studio, etc.).
# Leave LLM_BASE_URL empty to fall back to the mock adapter.
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_MODEL=llama3.2

# Reasoning models (Qwen3, etc.) emit a hidden <think> block as `delta.reasoning_content`.
# This is the server-wide DEFAULT for whether thinking is enabled; a conversation's
# per-conversation "Thinking" setting (⚙ popover) overrides it when set. Set to false
# (default) to disable thinking; true to keep it on.
LLM_CHAT_ENABLE_THINKING=false

# Default system prompt sent to the LLM. A conversation's per-conversation
# "System prompt override" (⚙ popover) takes precedence when set.
SYSTEM_PROMPT='You are a helpful assistant.'

# CLI-only assistant reply language (en | it | de). The web app derives this
# per-user from users.language (⚙ language switcher); the CLI has no JWT, so it
# reads this instead. Defaults to en. See ADR-007.
CHATBOT_LANGUAGE=en

# Auth (Phase 7) — JWT bearer + bcrypt. JWT_SECRET_KEY signs the access tokens
# and is REQUIRED (the api won't start without it). `make env` fills it with a
# random 32-byte hex value; leave it empty here. If you already have a dev .env,
# append one:  echo "JWT_SECRET_KEY=$(openssl rand -hex 32)" >> .env
# Tokens live 30 days (LAN app). LOGIN_RATE_LIMIT is a slowapi budget per client IP.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200
LOGIN_RATE_LIMIT=5/minute

# Web access (Phase 6) — the 🌐 composer toggle runs a prompted-JSON tool loop
# (DuckDuckGo search via `ddgs` + page extraction via `trafilatura`), with
# thinking forced off for the turn. Set WEB_TOOLS_ENABLED=false to swap in mock
# search/fetch adapters (offline dev). Caps bound the loop and each fetch.
WEB_TOOLS_ENABLED=true
WEB_TOOL_MAX_ITERATIONS=4
WEB_SEARCH_MAX_RESULTS=5
WEB_FETCH_MAX_CHARS=20000

# Attachments (Phase 5) — Garage (S3-compatible) object storage. In DEV this is
# an isolated per-app garage container (docker-compose.yml); in PRODUCTION the
# app uses the SHARED garage on shared_network (see deployment/). GARAGE_ENDPOINT
# here is the host view used by `make backend`; docker-compose overrides it to
# http://garage:3900 for the in-container api. Leave GARAGE_ENDPOINT empty to fall
# back to in-memory storage (no garage needed). The access key id MUST be `GK` +
# 12 hex bytes (24 hex chars) or Garage rejects it; `make env` fills the
# key/secret with the right format. GARAGE_ADMIN_TOKEN must match admin_token in
# garage/garage.toml.
GARAGE_ENDPOINT=http://localhost:3907
GARAGE_BUCKET=chatbot
GARAGE_REGION=garage
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=
GARAGE_ADMIN_TOKEN=chatbot-admin-secret
